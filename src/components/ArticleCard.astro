---
export interface Props {
  title: string;
  slug: string;
  date: string;
  category: string;
  excerpt: string;
  cover?: string;
  readingTime?: string;
  featured?: boolean;
}

const { title, slug, date, category, excerpt, cover, readingTime, featured } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<article class:list={['article-card sketch-border hover-lift', { 'article-card--featured': featured }]}>
  {cover && (
    <a href={`/journal/${slug}/`} class="article-card-cover" tabindex="-1" aria-hidden="true">
      <img src={cover} alt="" loading="lazy" width="600" height="340" />
      <div class="article-card-cover-overlay"></div>
    </a>
  )}
  <div class="article-card-body">
    <div class="article-card-meta">
      <span class="category-pill">{category}</span>
      <time datetime={date} class="article-card-date">{formattedDate}</time>
      {readingTime && <span class="article-card-reading hand-label">{readingTime} read</span>}
    </div>
    <h3 class="article-card-title">
      <a href={`/journal/${slug}/`}>{title}</a>
    </h3>
    <p class="article-card-excerpt">{excerpt}</p>
    <a href={`/journal/${slug}/`} class="article-card-link">
      Read entry →
    </a>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    background: white;
    overflow: hidden;
    transition: transform var(--transition-med), box-shadow var(--transition-med);
  }

  .article-card--featured {
    grid-column: span 2;
    flex-direction: row;
  }

  .article-card-cover {
    display: block;
    overflow: hidden;
    flex-shrink: 0;
    position: relative;
  }

  .article-card-cover img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    transition: transform var(--transition-med);
  }

  .article-card--featured .article-card-cover { width: 50%; }
  .article-card--featured .article-card-cover img { height: 100%; }

  .article-card:hover .article-card-cover img { transform: scale(1.04); }

  .article-card-cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(30,58,37,0.2), transparent);
  }

  .article-card-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .article-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-3);
  }

  .article-card-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .article-card-reading {
    font-size: 0.85rem;
    color: var(--color-olive);
    margin-left: auto;
  }

  .article-card-title {
    font-size: 1.25rem;
    margin-bottom: var(--space-3);
    line-height: 1.3;
  }

  .article-card-title a {
    color: var(--color-forest);
    text-decoration: none;
  }

  .article-card-title a:hover {
    color: var(--color-moss);
    text-decoration: none;
  }

  .article-card-excerpt {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
    margin-bottom: var(--space-5);
    flex: 1;
  }

  .article-card-link {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-lime-dark);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: gap var(--transition-fast);
  }

  .article-card-link:hover { gap: var(--space-3); text-decoration: none; }

  @media (max-width: 768px) {
    .article-card--featured { flex-direction: column; grid-column: span 1; }
    .article-card--featured .article-card-cover { width: 100%; }
  }
</style>
