---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('journal', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props:  { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const pubDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

// Estimate reading time (~200 wpm)
const wordCount = post.body.split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Top-level (h2) headings only for TOC
const tocItems = headings.filter(h => h.depth === 2);

// Related posts from same category (excluding self)
const allPosts = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .filter(p => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  article={true}
>
  <!-- Article header (forest green) -->
  <header class="article-header">
    <div class="container">
      <nav class="article-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">→</span>
        <a href="/journal/">Journal</a>
        <span aria-hidden="true">→</span>
        <span aria-current="page">{post.data.category}</span>
      </nav>

      <div class="article-meta">
        <span class="category-pill">{post.data.category}</span>
        <time datetime={post.data.date.toISOString()}>{pubDate}</time>
        <span class="hand-label" style="color:rgba(240,232,208,0.6)">{readingTime} min read</span>
      </div>

      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-desc">{post.data.description}</p>

      {post.data.tags.length > 0 && (
        <div class="article-tags" aria-label="Tags">
          {post.data.tags.map(tag => (
            <span class="article-tag">#{tag}</span>
          ))}
        </div>
      )}
    </div>

    {post.data.cover && (
      <div class="article-cover-wrap">
        <img
          src={post.data.cover}
          alt=""
          class="article-cover"
          width="1200" height="480"
          loading="eager"
        />
      </div>
    )}
  </header>

  <!-- Body -->
  <div class="article-body container">
    <!-- Table of Contents -->
    {tocItems.length > 2 && (
      <aside class="toc" aria-label="Table of contents">
        <p class="toc-title hand-label">Table of Contents</p>
        <ol class="toc-list">
          {tocItems.map(heading => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </aside>
    )}

    <!-- Article content -->
    <article class="article-content prose" aria-label="Article content">
      <Content />
    </article>
  </div>

  <!-- Divider -->
  <div class="ink-divider container" aria-hidden="true"></div>

  <!-- Related posts -->
  {allPosts.length > 0 && (
    <section class="related-posts section-pad-sm" aria-labelledby="related-heading">
      <div class="container">
        <h2 id="related-heading" class="related-title">Related Entries</h2>
        <div class="related-grid">
          {allPosts.map(p => (
            <a href={`/journal/${p.id}/`} class="related-card sketch-border">
              <span class="category-pill">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <span class="related-link">Read →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .article-header {
    background: var(--color-forest);
    color: var(--color-cream-text);
    padding: var(--space-10) 0 0;
  }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8rem;
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }

  .article-breadcrumb a {
    color: rgba(240,232,208,0.65);
    text-decoration: none;
  }
  .article-breadcrumb a:hover { color: var(--color-lime); }
  .article-breadcrumb span { color: rgba(240,232,208,0.4); }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: rgba(240,232,208,0.6);
  }

  .article-title {
    color: var(--color-lime);
    font-size: clamp(1.8rem, 4vw, 3rem);
    margin-bottom: var(--space-4);
    max-width: 860px;
  }

  .article-desc {
    color: rgba(240,232,208,0.8);
    font-size: 1.05rem;
    max-width: 700px;
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-bottom: var(--space-8);
  }

  .article-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(168,216,49,0.7);
    padding: 2px 8px;
  }

  .article-cover-wrap {
    width: 100%;
    max-height: 380px;
    overflow: hidden;
    margin-top: var(--space-4);
  }

  .article-cover {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
  }

  /* Body layout */
  .article-body {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-12);
    padding-top: var(--space-12);
    align-items: start;
  }

  /* TOC */
  .toc {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-6));
    background: var(--color-parchment-dark);
    border: 1.5px solid var(--color-charcoal);
    border-radius: var(--radius-sm);
    padding: var(--space-5);
  }

  .toc-title {
    font-size: 0.85rem;
    color: var(--color-olive);
    margin-bottom: var(--space-3);
    display: block;
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    counter-reset: toc;
  }

  .toc-list li::before {
    counter-increment: toc;
    content: counter(toc) '. ';
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-lime-dark);
  }

  .toc-list a {
    font-size: 0.82rem;
    color: var(--color-charcoal);
    text-decoration: none;
    line-height: 1.4;
  }

  .toc-list a:hover { color: var(--color-lime-dark); }

  /* Prose content */
  .prose {
    max-width: var(--content-width);
    padding-bottom: var(--space-16);
  }

  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    color: var(--color-forest);
  }

  .prose :global(h2) {
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-parchment-dark);
  }

  .prose :global(p) { margin-bottom: var(--space-5); }

  .prose :global(ul), .prose :global(ol) {
    padding-left: var(--space-6);
    margin-bottom: var(--space-5);
  }

  .prose :global(li) { margin-bottom: var(--space-2); }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-lime);
    padding: var(--space-4) var(--space-6);
    background: var(--color-parchment-dark);
    margin: var(--space-8) 0;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-style: italic;
    color: var(--text-secondary);
  }

  .prose :global(img) {
    border: 2px solid var(--color-charcoal);
    border-radius: var(--radius-sm);
    margin: var(--space-8) 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-8) 0;
    font-size: 0.9rem;
  }

  .prose :global(th), .prose :global(td) {
    border: 1.5px solid var(--color-parchment-dark);
    padding: var(--space-3) var(--space-4);
    text-align: left;
  }

  .prose :global(th) {
    background: var(--color-parchment-dark);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  .prose :global(a) {
    color: var(--color-lime-dark);
    font-weight: 500;
  }

  /* Related */
  .related-title {
    font-size: 1.4rem;
    margin-bottom: var(--space-6);
    color: var(--color-forest);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-5);
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-parchment);
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-med), box-shadow var(--transition-med);
  }

  .related-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); text-decoration: none; }
  .related-card h3 { font-size: 1rem; color: var(--color-forest); }
  .related-card p  { font-size: 0.85rem; color: var(--text-secondary); flex: 1; margin: 0; }
  .related-link    { font-size: 0.8rem; font-weight: 600; color: var(--color-lime-dark); }

  @media (max-width: 900px) {
    .article-body { grid-template-columns: 1fr; }
    .toc { position: static; }
  }
</style>
