---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, SOCIAL, SITE_TITLE } from '../../consts';
---

<BaseLayout title="Collaborate" description="Get in touch with BrewPine — for collaboration, feedback, or just to say hello.">
  <div class="contact-header">
    <div class="container">
      <p class="hand-label" style="color:var(--color-lime-dark)">✦ Let's Connect</p>
      <h1>Collaborate with BrewPine</h1>
    </div>
  </div>

  <section class="section-pad">
    <div class="container contact-grid">
      <!-- Intro -->
      <div class="contact-text">
        <h2>Let's make something interesting</h2>
        <p>BrewPine is an early-stage studio — always curious about collaborators, contributors, and people who want to make weird and interesting things.</p>
        <p>Whether you're a programmer, artist, writer, sound designer, or someone with an idea — reach out. The worst possible outcome is a conversation.</p>

        <div class="contact-method sketch-border">
          <p class="hand-label" style="color:var(--color-olive)">Best way to reach us</p>
          <a href={`mailto:${CONTACT_EMAIL}`} class="contact-email">
            {CONTACT_EMAIL}
          </a>
          <p class="contact-note">This is a real email. Messages are read by a real person. There is no form that quietly discards your message.</p>
        </div>

        <!-- Social links -->
        <div class="contact-social">
          <p class="hand-label" style="color:var(--color-olive);margin-bottom:var(--space-4);">Also find us at</p>
          <div class="social-list">
            {SOCIAL.github && (
              <a href={SOCIAL.github} class="social-link sketch-border" target="_blank" rel="noopener noreferrer">
                <span class="social-platform">GitHub</span>
                <span class="social-desc">Source code, experiments, and open projects</span>
                <span class="social-arrow">→</span>
              </a>
            )}
            {SOCIAL.itchio && (
              <a href={SOCIAL.itchio} class="social-link sketch-border" target="_blank" rel="noopener noreferrer">
                <span class="social-platform">itch.io</span>
                <span class="social-desc">Playable games and interactive releases</span>
                <span class="social-arrow">→</span>
              </a>
            )}
            {SOCIAL.youtube && (
              <a href={SOCIAL.youtube} class="social-link sketch-border" target="_blank" rel="noopener noreferrer">
                <span class="social-platform">YouTube</span>
                <span class="social-desc">Devlogs, tutorials, and behind-the-scenes</span>
                <span class="social-arrow">→</span>
              </a>
            )}
            {SOCIAL.twitter && (
              <a href={SOCIAL.twitter} class="social-link sketch-border" target="_blank" rel="noopener noreferrer">
                <span class="social-platform">Twitter</span>
                <span class="social-desc">Quick updates and studio dispatches</span>
                <span class="social-arrow">→</span>
              </a>
            )}
            {SOCIAL.discord && (
              <a href={SOCIAL.discord} class="social-link sketch-border" target="_blank" rel="noopener noreferrer">
                <span class="social-platform">Discord</span>
                <span class="social-desc">Community conversation and feedback</span>
                <span class="social-arrow">→</span>
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Doodle column -->
      <aside class="contact-art" aria-hidden="true">
        <svg viewBox="0 0 220 300" fill="none" xmlns="http://www.w3.org/2000/svg" class="contact-svg">
          <!-- Envelope -->
          <rect x="30" y="80" width="160" height="110" rx="3" stroke="var(--color-forest)" stroke-width="1.5"/>
          <path d="M30 83 L110 140 L190 83" stroke="var(--color-forest)" stroke-width="1.5" stroke-linejoin="round"/>
          <!-- Seal -->
          <circle cx="110" cy="145" r="12" stroke="var(--color-lime-dark)" stroke-width="1.5" stroke-dasharray="3 2"/>
          <circle cx="110" cy="145" r="5" fill="var(--color-lime-dark)" opacity="0.4"/>
          <!-- Pine doodle above -->
          <path d="M110 20 L120 38 H116 L124 54 H118 L128 72 H92 L102 54 H96 L104 38 H100 Z" stroke="var(--color-moss)" stroke-width="1.2" stroke-linejoin="round" fill="none"/>
          <line x1="110" y1="72" x2="110" y2="78" stroke="var(--color-moss)" stroke-width="1.5"/>
          <!-- Stars -->
          <circle cx="40" cy="40" r="2" fill="var(--color-lime-dark)" opacity="0.5"/>
          <circle cx="180" cy="35" r="1.5" fill="var(--color-lime-dark)" opacity="0.4"/>
          <circle cx="190" cy="200" r="2" fill="var(--color-moss)" opacity="0.4"/>
          <!-- Annotation arrows -->
          <path d="M25 135 Q15 130 20 120" stroke="var(--color-olive)" stroke-width="1" stroke-dasharray="2 2" opacity="0.7"/>
          <text x="5" y="115" font-size="10" fill="var(--color-olive)" font-family="cursive" opacity="0.7">say hi!</text>
          <!-- Bottom mushroom doodle -->
          <ellipse cx="110" cy="240" rx="18" ry="12" stroke="var(--color-moss-light)" stroke-width="1.2" stroke-dasharray="3 2"/>
          <path d="M96 240 Q95 258 98 265 M124 240 Q125 258 122 265" stroke="var(--color-moss-light)" stroke-width="1.2" stroke-linecap="round"/>
          <circle cx="104" cy="234" r="2" fill="var(--color-moss-light)" opacity="0.4"/>
          <circle cx="114" cy="231" r="1.5" fill="var(--color-moss-light)" opacity="0.35"/>
        </svg>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-header {
    background: var(--color-olive);
    color: var(--color-cream-text);
    padding: var(--space-16) 0 var(--space-12);
    border-bottom: 3px solid var(--color-lime);
  }

  .contact-header h1 { color: var(--color-cream-text); margin: var(--space-2) 0; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-16);
    align-items: start;
  }

  .contact-text h2 { margin-bottom: var(--space-4); }
  .contact-text p  { color: var(--text-secondary); margin-bottom: var(--space-5); }

  .contact-method {
    padding: var(--space-6);
    background: var(--color-parchment-dark);
    margin: var(--space-8) 0;
  }

  .contact-email {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-lime-dark);
    text-decoration: none;
    margin: var(--space-3) 0;
    word-break: break-all;
  }

  .contact-email:hover { text-decoration: underline; }

  .contact-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-style: italic;
    margin: 0;
  }

  .social-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--color-parchment);
    text-decoration: none;
    color: var(--text-primary);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .social-link:hover {
    transform: translateX(4px);
    text-decoration: none;
    border-color: var(--color-lime);
  }

  .social-platform {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-forest);
    min-width: 80px;
    flex-shrink: 0;
  }

  .social-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    flex: 1;
  }

  .social-arrow {
    color: var(--color-lime-dark);
    font-weight: 700;
    flex-shrink: 0;
  }

  .contact-art {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: var(--space-8);
  }

  .contact-svg {
    width: 100%;
    max-width: 220px;
    animation: float 8s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-10px); }
  }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-art  { display: none; }
  }
</style>
